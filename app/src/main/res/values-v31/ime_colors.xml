<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: wallpaper-driven Material You tokens for the IME strip.
     Referenced as @color/ime_* so pre-S devices fall back to values/. -->
<resources>
    <color name="ime_surface">@android:color/system_neutral1_900</color>
    <color name="ime_text_primary">@android:color/system_neutral1_50</color>
    <color name="ime_text_secondary">@android:color/system_neutral1_300</color>
    <color name="ime_accent">@android:color/system_accent1_600</color>
    <color name="ime_on_accent">@android:color/system_accent1_50</color>
    <color name="ime_mic_disabled">@android:color/system_neutral1_700</color>
    <color name="ime_dot_idle">@android:color/system_neutral2_500</color>
    <color name="ime_dot_recording">@android:color/system_accent1_300</color>
    <color name="ime_dot_uploading">@android:color/system_accent2_300</color>
    <color name="ime_dot_error">#FFFFB4AB</color>
    <color name="ime_wave_bar">@android:color/system_accent1_300</color>
</resources>
