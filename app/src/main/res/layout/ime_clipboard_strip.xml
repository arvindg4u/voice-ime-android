<?xml version="1.0" encoding="utf-8"?>
<!-- Single history chip inside the IME input view: one compact button
     showing the saved-clip count; tap opens the full history popup.
     Framework widgets and system colors only
     (Theme.DeviceDefault.InputMethod constraint). -->
<Button xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imeClipChip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:minHeight="@dimen/voice_button_min_height"
    android:textSize="@dimen/clip_strip_text_size"
    android:visibility="gone" />
