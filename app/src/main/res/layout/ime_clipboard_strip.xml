<?xml version="1.0" encoding="utf-8"?>
<!-- Compact history strip inside the IME input view: framework widgets and
     system colors only (Theme.DeviceDefault.InputMethod constraint). -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/imeClipStripScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:scrollbars="none"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/imeClipStrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/imeClipMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_strip_min_height"
            android:text="@string/clipboard_more"
            android:textSize="@dimen/clip_strip_text_size"
            android:visibility="gone" />
    </LinearLayout>
</HorizontalScrollView>
