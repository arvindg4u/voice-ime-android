<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-proof IME layout: NO ?attr/ theme references, NO M3 styles.
     The IME window runs under the SYSTEM input-method theme
     (Theme.DeviceDefault.InputMethod), not our app theme, so any
     ?attr/colorSurface etc. throws UnsupportedOperationException at
     inflation and the keyboard never appears. System colors and
     framework widgets only — dynamic color via @color/ime_* tokens
     (values-v31/ maps them to wallpaper-driven @android:color/system_*).
     Structure: status row + waveform + ONE single-line transport bar
     [pill | ghost cancel | clip badge | Enter]. Error-only Retry/Settings
     row below; no control second row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/ime_surface"
    android:paddingStart="@dimen/voice_horizontal_padding"
    android:paddingEnd="@dimen/voice_horizontal_padding"
    android:paddingTop="@dimen/voice_row_spacing"
    android:paddingBottom="@dimen/voice_row_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/voice_content_max_width"
        android:orientation="vertical">

    <!-- Live status: state dot + transcript preview (tail-follow: head
         ellipsis keeps the latest words visible without height growth). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/imeStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/ime_status_dot" />

        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="start"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/ime_status_idle"
            android:textColor="@color/ime_text_primary"
            android:textSize="@dimen/voice_status_text_size" />
    </LinearLayout>

    <!-- HERO waveform (decorative; contentDescription suppressed in code) -->
    <com.voiceime.WaveformView
        android:id="@+id/imeWave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/voice_wave_height"
        android:layout_marginTop="@dimen/voice_row_spacing" />

    <!-- Single-line transport bar: state pill (mic/stop + timer) |
         ghost cancel (recording/uploading only) | clip badge (saved
         clips only) | Enter. Everything GONE-unless-needed lives in
         this one row — no second button row, no strip line. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/voice_row_spacing"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/imeBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_back_description"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:id="@+id/imeTransport"
            android:layout_marginStart="4dp"
            android:layout_width="0dp"
            android:layout_height="@dimen/voice_transport_height"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ime_transport_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/imeTransportIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_btn_speak_now" />

            <TextView
                android:id="@+id/imeTransportLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/ime_transport_idle"
                android:textColor="@color/ime_on_accent"
                android:textSize="@dimen/voice_action_text_size" />

            <TextView
                android:id="@+id/imeTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0:00"
                android:textColor="@color/ime_on_accent"
                android:textSize="@dimen/voice_timer_text_size"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/imeCancel"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_cancel"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:visibility="gone" />

        <Button
            android:id="@+id/imeClipBadge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/voice_button_min_height"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/ime_accent"
            android:textSize="@dimen/clip_strip_text_size"
            android:visibility="gone" />

        <Button
            android:id="@+id/imeEnter"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/voice_button_min_height"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:contentDescription="@string/ime_enter_description"
            android:text="@string/ime_enter"
            android:textColor="@color/ime_accent"
            android:textSize="@dimen/voice_action_text_size" />
    </LinearLayout>

    <!-- Error row: Retry/Settings appear here only on error.
         GONE otherwise; Cancel lives in the transport row. -->
    <LinearLayout
        android:id="@+id/imeActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/imeRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_button_min_height"
            android:text="@string/ime_retry"
            android:textSize="@dimen/voice_action_text_size" />

        <Button
            android:id="@+id/imeSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_button_min_height"
            android:text="@string/ime_settings"
            android:textSize="@dimen/voice_action_text_size" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
