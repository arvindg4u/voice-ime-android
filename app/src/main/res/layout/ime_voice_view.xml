<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-proof IME layout: NO ?attr/ theme references, NO M3 styles.
     The IME window runs under the SYSTEM input-method theme
     (Theme.DeviceDefault.InputMethod), not our app theme, so any
     ?attr/colorSurface etc. throws UnsupportedOperationException at
     inflation and the keyboard never appears. System colors and
     framework widgets only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/system_neutral1_900"
    android:padding="@dimen/voice_horizontal_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:maxWidth="@dimen/voice_content_max_width"
        android:orientation="vertical">

    <!-- Top status row: state dot + status + timer right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/imeStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/ime_status_dot" />

        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/ime_status_idle"
            android:textColor="@android:color/system_neutral1_50"
            android:textSize="@dimen/voice_status_text_size" />

        <TextView
            android:id="@+id/imeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@android:color/system_neutral1_300"
            android:textSize="@dimen/voice_timer_text_size" />
    </LinearLayout>

    <!-- HERO waveform (compact tall, full-width touch not needed — decorative) -->
    <com.voiceime.WaveformView
        android:id="@+id/imeWave"
        android:layout_width="match_parent"
        android:layout_height="@dimen/voice_wave_height"
        android:layout_marginTop="8dp" />

    <!-- Clipboard history strip (framework widgets, system colors only). -->
    <include layout="@layout/ime_clipboard_strip" />

    <!-- Mic row: compact mic left, Stop pill, Enter right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/imeMic"
            android:layout_width="@dimen/voice_mic_size"
            android:layout_height="@dimen/voice_mic_size"
            android:background="@android:drawable/btn_default"
            android:contentDescription="@string/ime_mic_description"
            android:src="@android:drawable/ic_btn_speak_now" />

        <Button
            android:id="@+id/imeStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="@dimen/voice_button_min_height"
            android:text="@string/ime_stop"
            android:textSize="@dimen/voice_action_text_size"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/imeEnter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_button_min_height"
            android:contentDescription="@string/ime_enter_description"
            android:text="@string/ime_enter"
            android:textSize="@dimen/voice_action_text_size" />
    </LinearLayout>

    <!-- Second row: text buttons. GONE unless a child is visible (Cancel
         mid-record/upload, Retry/Settings on error); renderState() follows
         child visibility via ImeLayoutPolicy so idle stays compact. -->
    <LinearLayout
        android:id="@+id/imeActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/imeCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_button_min_height"
            android:text="@string/ime_cancel"
            android:textSize="@dimen/voice_action_text_size" />

        <Button
            android:id="@+id/imeRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_button_min_height"
            android:text="@string/ime_retry"
            android:textSize="@dimen/voice_action_text_size" />

        <Button
            android:id="@+id/imeSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/voice_button_min_height"
            android:text="@string/ime_settings"
            android:textSize="@dimen/voice_action_text_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/imeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/ime_hint_clips"
        android:textColor="@android:color/system_neutral1_300"
        android:textSize="@dimen/voice_hint_text_size" />
    </LinearLayout>
</LinearLayout>
