<?xml version="1.0" encoding="utf-8"?>
<!-- Crash-proof IME layout: NO ?attr/ theme references, NO M3 styles.
     The IME window runs under the SYSTEM input-method theme
     (Theme.DeviceDefault.InputMethod), not our app theme, so any
     ?attr/colorSurface etc. throws UnsupportedOperationException at
     inflation and the keyboard never appears. System colors and
     framework widgets only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/system_neutral1_900"
    android:padding="12dp">

    <!-- Top status row: state dot + status + timer right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/imeStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/ime_status_dot" />

        <TextView
            android:id="@+id/imeStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/ime_status_idle"
            android:textColor="@android:color/system_neutral1_50"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/imeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@android:color/system_neutral1_300"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- HERO waveform -->
    <com.voiceime.WaveformView
        android:id="@+id/imeWave"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="12dp" />

    <!-- Mic row: FAB mic left, Stop pill, Enter tonal right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/imeMic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@android:drawable/btn_default"
            android:contentDescription="@string/ime_mic_description"
            android:src="@android:drawable/ic_btn_speak_now" />

        <Button
            android:id="@+id/imeStop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/ime_stop"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/imeEnter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ime_enter_description"
            android:text="@string/ime_enter" />
    </LinearLayout>

    <!-- Second row: text buttons, visibility logic unchanged -->
    <LinearLayout
        android:id="@+id/imeActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/imeCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ime_cancel" />

        <Button
            android:id="@+id/imeRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ime_retry" />

        <Button
            android:id="@+id/imeSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ime_settings" />
    </LinearLayout>

    <TextView
        android:id="@+id/imeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/ime_hint_clips"
        android:textColor="@android:color/system_neutral1_300"
        android:textSize="12sp" />
</LinearLayout>
